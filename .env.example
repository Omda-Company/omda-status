# انسخه لـ .env.local للتجربة على الجهاز. وعلى Vercel: Project → Settings → Environment Variables.
# كل الأسامي بتتقبل كمان بـ OMDA_ في أولها.

# --- الدخول (الاتنين لازم يتحطوا، وإلا اللوحة كلها بتفضل مقفولة) ---
STATUS_PASSWORD=          # الباسورد اللي هيتبعت للإدارة
STATUS_SECRET=            # نص عشوائي طويل (32 حرف أو أكتر)

# --- البيانات (Supabase مخصوصة للعمدة) ---
SUPABASE_URL=             # https://<ref>.supabase.co
SUPABASE_SECRET_KEY=      # المفتاح السري (secret / service_role). سيرفر بس، عمره ما يتحط في المتصفح

# --- منع Supabase المجاني من إنه يقف ---
CRON_SECRET=              # نص عشوائي. Vercel بيبعته لوحده مع الطلب اليومي لـ /api/keepalive
